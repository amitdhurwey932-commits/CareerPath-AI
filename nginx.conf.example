# ─────────────────────────────────────────────────────────────────────────────
# Nginx configuration for CareerPath AI
# ─────────────────────────────────────────────────────────────────────────────
#
# Prerequisites
# ─────────────────────────────────────────────────────────────────────────────
# 1. Replace every occurrence of "yourdomain.com" with your actual domain.
# 2. Install Certbot and the Nginx plugin:
#       sudo apt install certbot python3-certbot-nginx
# 3. Obtain your certificate (Certbot edits this file automatically):
#       sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com
# 4. After Certbot finishes, reload Nginx:
#       sudo nginx -s reload
# 5. Certbot sets up auto-renewal via a systemd timer or cron job.
#    Test it with: sudo certbot renew --dry-run
#
# How this config works
# ─────────────────────────────────────────────────────────────────────────────
# • Server block 1 (port 80) — immediately redirects all HTTP to HTTPS.
#   Certbot uses the /.well-known/acme-challenge/ location to verify domain
#   ownership, so that location must NOT be redirected.
# • Server block 2 (port 443) — terminates TLS, proxies to Gunicorn on
#   127.0.0.1:8000, and adds security headers.
#
# File location: /etc/nginx/sites-available/careerpath-ai
# Enable with:   sudo ln -s /etc/nginx/sites-available/careerpath-ai \
#                              /etc/nginx/sites-enabled/
#                sudo nginx -t && sudo nginx -s reload
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP → HTTPS redirect ─────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com;

    # Let's Encrypt ACME challenge — must be served over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect everything else to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS server ──────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name yourdomain.com www.yourdomain.com;

    # ── TLS certificate (managed by Certbot) ─────────────────────────────────
    # These two lines are added automatically by Certbot.  If you are managing
    # certificates manually, replace the paths with the correct ones.
    ssl_certificate     /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;

    # Certbot also writes a file with recommended TLS settings; include it:
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # ── Security headers ──────────────────────────────────────────────────────
    # HSTS: tell browsers to use HTTPS for the next year.
    # Remove the preload directive until you are confident the site works
    # fully over HTTPS, because HSTS preloading is very hard to undo.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff"                              always;
    add_header X-Frame-Options           "SAMEORIGIN"                           always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"      always;

    # ── Static files served directly by Nginx ────────────────────────────────
    # Bypass Gunicorn for static assets to reduce latency and CPU usage.
    location /static/ {
        alias /path/to/careerpath-ai/static/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # ── Proxy to Gunicorn ─────────────────────────────────────────────────────
    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # Forward the real client IP and protocol to Flask/ProxyFix.
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Timeouts — increase if AI calls are slow.
        proxy_connect_timeout 10s;
        proxy_read_timeout    65s;
        proxy_send_timeout    65s;

        # Buffer settings.
        proxy_buffering    on;
        proxy_buffer_size  8k;
        proxy_buffers      8 8k;
    }

    # ── Logging ───────────────────────────────────────────────────────────────
    access_log /var/log/nginx/careerpath-ai-access.log;
    error_log  /var/log/nginx/careerpath-ai-error.log warn;
}
